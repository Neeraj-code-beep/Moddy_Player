# Required service configuration. Keep real values in an ignored .env or secret manager.
PORT=3000
MONGODB_URL=
MONGODB_CONNECT_TIMEOUT_MS=10000
# Optional and test-only: a dedicated disposable non-production MongoDB URI.
MONGODB_INTEGRATION_URL=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for authentication startup. Generate at least 32 random bytes and
# store the real value in .env or a secret manager, never in source control.
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
AUTH_REFRESH_TTL_DAYS=30
AUTH_COOKIE_SAME_SITE=lax
# Defaults to false outside production and true in production; SameSite=None requires true.
AUTH_COOKIE_SECURE=

# Upload size: 1 byte through 100 MiB; default 25 MiB.
MAX_UPLOAD_SIZE_BYTES=26214400
# Bounds how long the API waits before returning 504. This does not cancel the SDK request.
IMAGEKIT_UPLOAD_RESPONSE_TIMEOUT_MS=30000

# Optional asynchronous semantic music analysis. Keep the API key server-side.
MUSIC_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
MUSIC_AI_TIMEOUT_MS=60000
MUSIC_AI_MAX_ATTEMPTS=5
MUSIC_AI_WORKER_CONCURRENCY=2
MUSIC_AI_JOB_LEASE_MS=120000
MUSIC_AI_RETRY_BASE_MS=2000

# Fixed-window abuse limits. Defaults: 60 seconds, uploads 3, feedback 30,
# recommendations 60, and catalog reads 120 requests per client IP.
# Window range: 1000–3600000 ms. Each max must be a positive integer.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=3
RATE_LIMIT_FEEDBACK_MAX=30
RATE_LIMIT_RECOMMENDATION_MAX=60
RATE_LIMIT_CATALOG_MAX=120
RATE_LIMIT_ANALYSIS_MAX=10
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_PASSWORD_MAX=5
RATE_LIMIT_PROFILE_MAX=30

# Keep 0 unless a known reverse proxy overwrites forwarded headers and the
# service is reachable only through exactly this many trusted proxy hops.
# Valid range: 0–10. Never set this to an unbounded trust mode.
TRUSTED_PROXY_HOPS=0
